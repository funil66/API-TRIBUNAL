# Test Environment
NODE_ENV=test
PORT=3001

# Test Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=legal_search_test
DB_PASSWORD=legal_search_test
DB_DATABASE=legal_search_test
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Test Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Test JWT
JWT_SECRET=test-jwt-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d

# Test Logging
LOG_LEVEL=error
LOG_FILE_ENABLED=false
